# Static analysis for RcLights, enforced by tools/ci.sh lint and by the lint
# stage in .gitlab-ci.yml.
#
# The check list comes from arduino_crsf; the suppressions do not, and each one
# below is justified.
#
# The purpose is regression protection: the enabled checks currently report
# nothing, so the job is blocking rather than allow_failure. WarningsAsErrors
# covers everything, because a clang-tidy run without it exits 0 on warnings.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-err58-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -performance-enum-size

WarningsAsErrors: '*'

# tools/ci.sh passes this same value as --header-filter, because at least one
# clang-tidy build loads it from here and then does not apply it. It lives here
# so editors use it too, and ci.sh reads it from this file rather than keeping a
# second copy.
HeaderFilterRegex: 'rclights_(core|config|board)\.h$|RcLights\.h$'

# Why each suppression above, so that nobody has to guess next time whether a
# check is missing for a reason or out of convenience:
#
# bugprone-easily-swappable-parameters
#   Fires on any two adjacent parameters of one type. The calibration is three
#   microsecond values in the order the user reads them off a transmitter; a
#   structure per argument pair would make the API worse. rcl_config_validate()
#   catches a swapped pair, which this check only makes harder to write.
#
# bugprone-narrowing-conversions
#   The core computes in int32_t and emits uint8_t. Every such conversion sits
#   behind a clamp to 0..255 that the check cannot see.
#
# cert-dcl37-c / cert-dcl51-cpp
#   Reserved identifiers. Fires on the include guards, which are not reserved.
#
# cert-err33-c
#   Wants the return value of printf checked. Pointless in the test suites.
#
# cert-err58-cpp
#   Wants a static-storage constructor that cannot throw: the one RcLights
#   instance a sketch creates, and the test mocks. Nothing here uses exceptions.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#   Wants memset_s from C11 Annex K, which is optional and provided by none of
#   avr-libc, newlib or glibc. Both calls zero a structure via sizeof(*ptr), so
#   there is no length that could be wrong.
#
# misc-include-cleaner
#   Wants every name included directly. Against Arduino.h, itself an umbrella
#   over a dozen headers, that yields suggestions which fail on another core.
#
# misc-const-correctness
#   Fires on variables the CHECK_EQ_* macros create. test_util.h is unchanged
#   from c_crsf and is not adjusted for a C++ quirk no other repository has.
#
# misc-non-private-member-variables-in-classes
#   Fires on RcLights::outputs for being public, which is the interface: a
#   sketch writes it exactly as it writes lights.esc_mode. The only difference
#   is that esc_mode is inherited from rcl_config_t, an all-public struct the
#   check ignores, and outputs is not.
#
# misc-use-anonymous-namespace
#   Wants anonymous namespaces instead of `static`. `static` is the idiom in all
#   four repositories, three of which are C, where they do not exist.
#
# performance-enum-size
#   Wants uint8_t as the base type of the eight enumerations. Seven are in a C11
#   header, and `enum x : uint8_t` has only existed in C since C23; converting
#   the eighth alone would not satisfy the check. The gain is nil on the
#   tightest target anyway, since avr-gcc defaults to -fshort-enums.
#
#   If this comes up again: enum size feeds into sizeof(rcl_config_t), which
#   tests/test_example_defaults.cpp checks against a fixed value.
