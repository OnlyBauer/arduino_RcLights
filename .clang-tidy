# Static analysis for RcLights, enforced by tools/ci.sh lint and by the lint
# stage in .gitlab-ci.yml.
#
# The check list is taken over from arduino_crsf; the suppressions explicitly
# are not. This repository has no vendored third-party core and no wire
# protocol, so most of the reasons something had to be switched off there do not
# apply. What is listed here is justified; what was listed there and is missing
# here was never true of this repository.
#
# The purpose is regression protection, not bug hunting: at the state it was
# introduced, the enabled checks report nothing across rclights_core.c and
# RcLights.cpp. The job is therefore blocking from the outset rather than
# allow_failure -- it is meant to go red as soon as the next patch adds
# something.
#
# WarningsAsErrors covers everything the checks can produce. A clang-tidy run
# without it exits 0 even on warnings and would be silently worthless in CI.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-err58-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -performance-enum-size

WarningsAsErrors: '*'

# Note that tools/ci.sh passes this same value on the command line as
# --header-filter, because at least one clang-tidy build loads it from here and
# then does not apply it, which made every finding in these headers invisible
# locally while it fired in CI. The value lives here so that editors and IDE
# integrations use it too; ci.sh reads it out of this file rather than keeping a
# second copy that could drift.
HeaderFilterRegex: 'rclights_(core|config|board)\.h$|RcLights\.h$'

# The reason for each individual suppression above -- without this list, nobody
# would know next time whether a check is missing for a good reason or out of
# convenience:
#
# bugprone-easily-swappable-parameters
#   Reports every function with two adjacent parameters of the same type. The
#   calibration consists of three microsecond values in a row (min, center, max)
#   and the brightness levels of several uint8_t; in that order both are what
#   the user sees in the data sheet and on the transmitter, and a structure per
#   pair of arguments would make the API worse rather than safer. The
#   calibration values are checked by rcl_config_validate() instead, which
#   actually catches a swapped pair rather than merely making one harder to
#   write.
#
# bugprone-narrowing-conversions
#   The core logic computes in int32_t and emits brightness as uint8_t. Every
#   one of those conversions sits behind a clamp to 0..255 that this check
#   cannot see.
#
# cert-dcl37-c / cert-dcl51-cpp
#   Reserved identifiers. Fires on the include guards (RCLIGHTS_..._H), which
#   are not reserved.
#
# cert-err33-c
#   Requires checking the return value of printf and friends. In the test suites
#   that is pointless.
#
# cert-err58-cpp
#   Requires that the constructor of an object with static storage duration
#   cannot throw. Here that means the one static RcLights instance every sketch
#   creates, and the mocks in tests/. No repository of this project uses
#   exceptions; the target is microcontrollers.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#   Requires memset_s from C11 Annex K for the two memset calls in
#   rclights_core.c. Annex K is optional, and none of the C libraries in
#   question here -- avr-libc, newlib, glibc -- provides it. Both calls zero a
#   structure of known size via sizeof(*ptr); there is no length that could be
#   wrong.
#
# misc-include-cleaner
#   Requires every name used to be included directly. Applied to Arduino.h,
#   which is itself an umbrella over half a dozen core headers, that produces
#   suggestions which do not compile on a different core.
#
# misc-const-correctness
#   Reports the scalar variables the CHECK_EQ_* macros in test_util.h create.
#   test_util.h is taken over unchanged from c_crsf and is not going to be
#   adjusted for a C++ quirk that exists in no other repository of this project.
#
# misc-non-private-member-variables-in-classes
#   Reports RcLights::outputs for being public. That is the interface, not an
#   oversight: a sketch writes `lights.outputs = ...` exactly as it writes
#   `lights.esc_mode = ...`. The only difference is that esc_mode is inherited
#   from rcl_config_t -- a structure whose fields are all public, which this
#   check therefore ignores -- and outputs is not, because LED polarity
#   describes the wiring rather than the controller. So the check singles out
#   exactly one field of a class whose configuration surface is entirely public
#   anyway.
#
# misc-use-anonymous-namespace
#   Requires anonymous namespaces instead of internal linkage via `static`.
#   `static` for file-local functions is the idiom in all four repositories,
#   three of which are pure C, where anonymous namespaces do not exist.
#
# performance-enum-size
#   Suggests shrinking the base type of each of the eight enumerations to
#   uint8_t. The suggestion cannot be acted on here: rclights_core.h is a C11
#   header, and the syntax `enum x : uint8_t` has only existed in C since C23.
#   Seven of the eight enumerations are in that file. Converting the eighth
#   (RcLightsOutputs, C++) on its own would not satisfy the check and would make
#   the two halves of the library inconsistent.
#
#   The gain would be small in any case, and on the tightest target none at all:
#   avr-gcc compiles with -fshort-enums by default, so every one of these
#   enumerations is already a single byte there. On ESP32 and STM32 they are
#   four bytes, and there memory is not the constraint.
#
#   Worth knowing if this ever comes up again: the size of the enumerations
#   feeds into sizeof(rcl_config_t), and tests/test_example_defaults.cpp checks
#   that against a fixed value.
