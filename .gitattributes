# Pin down the line endings. The library is developed on Windows and built in
# Linux containers; without this file it depends on the local core.autocrlf
# setting whether a commit carries CRLF into the repository.
#
# `* text=auto` normalises everything Git considers text to LF in the
# repository. The entries below take the heuristic out of the equation.

* text=auto

*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.ino  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
Makefile text eol=lf
Doxyfile text eol=lf
library.properties text eol=lf
.clang-format text eol=lf
.clang-tidy   text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# keywords.txt needs real tabs; the IDE splits on them and silently ignores a
# line that uses spaces. This entry is here only for the line endings, though --
# .gitattributes cannot protect tabs, tools/ci.sh lint does that.
*.txt  text eol=lf

# PowerShell expects CRLF.
*.ps1  text eol=crlf
