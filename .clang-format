# Formatting rules for arduino_rclights, enforced by tools/ci.sh lint and by the
# lint stage in .gitlab-ci.yml.
#
# Taken over word for word from arduino_crsf, deliberately and without
# adjustment: the four repositories of this project are maintained by the same
# person and often touched on the same day. A style that differs between them
# produces diff noise on every switch that means nothing. The reasoning below
# comes from the measurements made there and holds here unchanged.
#
# The style in one sentence: Linux braces, four spaces, star on the name, no
# automatic wrapping.

BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

# No column limit, so clang-format does not re-wrap anything that is already
# wrapped. This is the most important switch here: with a limit, the tool
# reformats every expression to its own taste and the change becomes large
# without a single line getting easier to read. Line length stays the author's
# business -- the existing code is under 100 columns bar two files, and is meant
# to stay that way.
ColumnLimit: 0

# Function body brace on its own line, control flow brace on the same line.
BreakBeforeBraces: Linux

# uint8_t *out, not uint8_t* out.
PointerAlignment: Right
ReferenceAlignment: Right

# The include order is intentional (own header first, then system), and
# clang-format is not to sort it alphabetically.
SortIncludes: Never

# A one-line body belongs on its own lines for a function; the short form
# `if (!r) { return false; }` for guards stays allowed. This is a departure from
# the three sister projects, and the only one.
#
# clang-format has no separate "C": .c and .cpp are both formatted as Cpp, so
# there is no language-dependent section. This repository's own C++ is confined
# to the Arduino wrapper, which is why the setting can be changed here without
# side effects on the C core.
#
# With None, each of the trivial accessors in RcLights.h becomes a four-liner.
# That is right for C, which has none, and it makes the very file that is the
# library's shop window unreadable. Inline leaves only short methods defined
# *inside* a class on one line; free-standing functions stay expanded as
# everywhere else.
AllowShortFunctionsOnASingleLine: Inline

# public:/private: at the level of the class rather than indented two columns.
AccessModifierOffset: -4
AllowShortBlocksOnASingleLine: Always
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# (uint8_t)x, not (uint8_t) x.
SpaceAfterCStyleCast: false

# case at the height of the switch, as in the existing code.
IndentCaseLabels: false
IndentGotoLabels: false
IndentPPDirectives: None

# Do not force alignment: the existing code aligns `=` in some blocks
# deliberately and deliberately does not in others. A global Consecutive
# measurably enlarged the reformatting (15 % -> 17 %), because it rewrites the
# places that are not aligned. Where alignment is intentional, it sits under
# `clang-format off`.
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignAfterOpenBracket: Align
AlignOperands: Align

# Do not re-wrap comments. The files are heavily commented, often with
# paragraphs, lists and column tables inside them; a reflow takes those apart.
ReflowComments: false

# Pack arguments and parameters densely rather than one per line.
BinPackArguments: true
BinPackParameters: true

# Remove a blank line at the start of a block, limit repeated blank lines to one.
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

InsertNewlineAtEOF: true
